generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String   @default("")
  password      String?
  role          String   @default("BUYER") // BUYER, SELLER, ADMIN
  avatar        String   @default("")
  phone         String   @default("")
  address       String   @default("")
  bio           String   @default("")
  isVerified    Boolean  @default(false)
  googleId      String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  businessProfile BusinessProfile?
  products        Product[]
  transactions    Transaction[] @relation("BuyerTransactions")
  sales           Transaction[] @relation("SellerSales")
  sentMessages    Message[]     @relation("SentMessages")
  chatRoomsBuyer  ChatRoom[]    @relation("ChatRoomBuyer")
  chatRoomsSeller ChatRoom[]    @relation("ChatRoomSeller")
  cotizaciones    Cotizacion[]
  cotizacionesResponses CotizacionResponse[]
  notifications   Notification[]
  likes           Like[]
  savedProducts   SavedProduct[]
  follows         Follow[]      @relation("Following")
  followers       Follow[]      @relation("Followers")
  auditLogs       AuditLog[]
}

model BusinessProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  businessName   String   @default("")
  description    String   @default("")
  category       String   @default("")
  address        String   @default("")
  latitude       Float?
  longitude      Float?
  phone          String   @default("")
  coverImage     String   @default("")
  logo           String   @default("")
  hours          String   @default("")
  paymentMethods String   @default("") // JSON string of accepted payment methods
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallPosts WallPost[]
}

model Product {
  id              String   @id @default(cuid())
  sellerId        String
  title           String
  description     String   @default("")
  price           Float
  discountPrice   Float?
  discountPercent Float?
  category        String   @default("")
  tags            String   @default("") // comma-separated
  images          String   @default("") // JSON array of image URLs
  videoUrl        String   @default("")
  quantity        Int      @default(1)
  status          String   @default("ACTIVE") // ACTIVE, PAUSED, SOLD, DELETED
  isFeatured      Boolean  @default(false)
  discountStart   DateTime?
  discountEnd     DateTime?
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  seller       User        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  likes        Like[]
  savedBy      SavedProduct[]
  chatRooms    ChatRoom[]
  cotizacionResponses CotizacionResponse[]
}

model Transaction {
  id             String   @id @default(cuid())
  buyerId        String
  sellerId       String
  productId      String
  amount         Float
  paymentMethod  String   // PAYPAL, BANPRO, BAC, LAFISE, BILLETERA
  status         String   @default("PENDING") // PENDING, COMPLETED, FAILED, REFUNDED
  cedula         String   @default("")
  cardLast4      String   @default("")
  paymentDetails String   @default("") // encrypted JSON
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  buyer   User    @relation("BuyerTransactions", fields: [buyerId], references: [id])
  seller  User    @relation("SellerSales", fields: [sellerId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Message {
  id         String   @id @default(cuid())
  chatRoomId String
  senderId   String
  content    String   @default("")
  imageUrl   String   @default("")
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender   User     @relation("SentMessages", fields: [senderId], references: [id])
}

model ChatRoom {
  id            String    @id @default(cuid())
  buyerId       String
  sellerId      String
  productId     String?
  lastMessage   String    @default("")
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  buyer   User     @relation("ChatRoomBuyer", fields: [buyerId], references: [id])
  seller  User     @relation("ChatRoomSeller", fields: [sellerId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  messages Message[]
}

model Cotizacion {
  id          String   @id @default(cuid())
  buyerId     String
  title       String
  description String   @default("")
  category    String   @default("")
  status      String   @default("OPEN") // OPEN, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  buyer     User                @relation(fields: [buyerId], references: [id])
  responses CotizacionResponse[]
}

model CotizacionResponse {
  id            String   @id @default(cuid())
  cotizacionId  String
  sellerId      String
  price         Float
  description   String   @default("")
  deliveryTime  String   @default("")
  status        String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt     DateTime @default(now())

  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  seller     User       @relation(fields: [sellerId], references: [id])
  product    Product?   @relation(fields: [productId], references: [id])
  productId  String?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // MESSAGE, COTIZACION, PAYMENT, FOLLOW, LIKE
  title     String
  message   String   @default("")
  isRead    Boolean  @default(false)
  link      String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  followingId String
  createdAt  DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model SavedProduct {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String   @default("")
  entityId  String   @default("")
  details   String   @default("")
  ip        String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model WallPost {
  id               String   @id @default(cuid())
  businessProfileId String
  content          String   @default("")
  imageUrl         String   @default("")
  createdAt        DateTime @default(now())

  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
