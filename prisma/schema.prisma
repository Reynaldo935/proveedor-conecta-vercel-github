generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String   @default("")
  password      String?
  role          String   @default("BUYER") // BUYER, SELLER, ADMIN
  helperRole    String   @default("") // DEVELOPER, MARKETING, FULLSTACK, GRAPHIC_DESIGN, COMMUNICATOR
  avatar        String   @default("")
  coverPhoto    String   @default("")
  phone         String   @default("")
  department    String   @default("")
  address       String   @default("")
  bio           String   @default("")
  website       String   @default("")
  isVerified    Boolean  @default(false)
  googleId      String?
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  balance       Float    @default(50000) // User wallet balance in NIO
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  businessProfile BusinessProfile?
  products        Product[]
  transactions    Transaction[] @relation("BuyerTransactions")
  sales           Transaction[] @relation("SellerSales")
  sentMessages    Message[]     @relation("SentMessages")
  chatRoomsBuyer  ChatRoom[]    @relation("ChatRoomBuyer")
  chatRoomsSeller ChatRoom[]    @relation("ChatRoomSeller")
  cotizaciones    Cotizacion[]
  cotizacionesResponses CotizacionResponse[]
  notifications   Notification[]
  likes           Like[]
  savedProducts   SavedProduct[]
  follows         Follow[]      @relation("Following")
  followers       Follow[]      @relation("Followers")
  auditLogs       AuditLog[]
  advertisements  Advertisement[]
  postLikes       PostLike[]
  postComments    PostComment[]
  loyaltyPoints   LoyaltyPoint[]
  pointHistory    PointHistory[]
  givenRatings    Review[] @relation("GivenRatings")
  receivedRatings Review[] @relation("ReceivedRatings")
  reviewVotes     ReviewVote[]
  calendarEvents  CalendarEvent[]
  appointments    Appointment[] @relation("BuyerAppointments")
  sellerAppointments Appointment[] @relation("SellerAppointments")
}

model BusinessProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  businessName   String   @default("")
  description    String   @default("")
  category       String   @default("")
  address        String   @default("")
  latitude       Float?
  longitude      Float?
  phone          String   @default("")
  coverImage     String   @default("")
  logo           String   @default("")
  hours          String   @default("")
  paymentMethods String   @default("") // JSON string of accepted payment methods
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallPosts WallPost[]
}

model Product {
  id              String   @id @default(cuid())
  sellerId        String
  title           String
  description     String   @default("")
  price           Float
  discountPrice   Float?
  discountPercent Float?
  category        String   @default("")
  tags            String   @default("") // comma-separated
  images          String   @default("") // JSON array of image URLs
  videoUrl        String   @default("")
  quantity        Int      @default(1)
  status          String   @default("ACTIVE") // ACTIVE, PAUSED, SOLD, DELETED
  isFeatured      Boolean  @default(false)
  discountStart   DateTime?
  discountEnd     DateTime?
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  seller       User        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  likes        Like[]
  savedBy      SavedProduct[]
  chatRooms    ChatRoom[]
  cotizacionResponses CotizacionResponse[]
  quantityDiscounts QuantityDiscount[]
}

model Transaction {
  id              String   @id @default(cuid())
  buyerId         String
  sellerId        String
  productId       String
  amount          Float
  commission      Float    @default(0) // 3% commission amount
  sellerPayout    Float    @default(0) // 97% seller payout
  paymentMethod   String   // PAYPAL, BANPRO, BAC, LAFISE, BILLETERA, PIXELPAY, PAGADITO, GOOGLE_PAY, BANPRO_BILLETERA, KASH, WESTERN_UNION
  status          String   @default("PENDING") // PENDING, COMPLETED, FAILED, REFUNDED
  cedula          String   @default("")
  cardLast4       String   @default("")
  paymentDetails  String   @default("") // encrypted JSON
  voucherUrl      String   @default("") // Payment voucher URL
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  buyer   User    @relation("BuyerTransactions", fields: [buyerId], references: [id])
  seller  User    @relation("SellerSales", fields: [sellerId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Message {
  id           String   @id @default(cuid())
  chatRoomId   String
  senderId     String
  content      String   @default("")
  imageUrl     String   @default("")
  messageType  String   @default("text") // text, image, video, audio, location
  mediaUrl     String   @default("")
  locationLat  Float?
  locationLng  Float?
  locationName String   @default("")
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender   User     @relation("SentMessages", fields: [senderId], references: [id])
}

model ChatRoom {
  id            String    @id @default(cuid())
  buyerId       String
  sellerId      String
  productId     String?
  lastMessage   String    @default("")
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  buyer   User     @relation("ChatRoomBuyer", fields: [buyerId], references: [id])
  seller  User     @relation("ChatRoomSeller", fields: [sellerId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  messages Message[]
}

model Cotizacion {
  id          String   @id @default(cuid())
  buyerId     String
  title       String
  description String   @default("")
  category    String   @default("")
  status      String   @default("OPEN") // OPEN, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  buyer     User                @relation(fields: [buyerId], references: [id])
  responses CotizacionResponse[]
}

model CotizacionResponse {
  id            String   @id @default(cuid())
  cotizacionId  String
  sellerId      String
  price         Float
  description   String   @default("")
  deliveryTime  String   @default("")
  status        String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt     DateTime @default(now())

  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  seller     User       @relation(fields: [sellerId], references: [id])
  product    Product?   @relation(fields: [productId], references: [id])
  productId  String?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // MESSAGE, COTIZACION, PAYMENT, FOLLOW, LIKE
  title     String
  message   String   @default("")
  isRead    Boolean  @default(false)
  link      String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  followingId String
  createdAt  DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model SavedProduct {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String   @default("")
  entityId  String   @default("")
  details   String   @default("")
  ip        String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model WallPost {
  id               String   @id @default(cuid())
  businessProfileId String
  content          String   @default("")
  imageUrl         String   @default("")
  videoUrl         String   @default("")
  postType         String   @default("text") // text, photo, video
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  likes           PostLike[]
  comments        PostComment[]
}

model PostLike {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post WallPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model PostComment {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  content   String
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post WallPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PhoneVerification {
  id        String   @id @default(cuid())
  phone     String
  code      String
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model QuantityDiscount {
  id        String   @id @default(cuid())
  productId String
  minQty    Int      // minimum quantity to activate discount
  discountPercent Float // e.g. 10 means 10% off
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Advertisement {
  id           String   @id @default(cuid())
  sellerId     String
  type         String   // PUBLISH, REMOVE
  plan         String   // WEEKLY, MONTHLY
  title        String
  description  String   @default("")
  imageUrl     String   @default("")
  targetUrl    String   @default("")
  amount       Float    @default(0)
  status       String   @default("PENDING") // PENDING, ACTIVE, PAUSED, EXPIRED, REJECTED
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model CommissionLog {
  id             String   @id @default(cuid())
  transactionId  String
  amount         Float
  rate           Float    @default(0.03)
  destination    String   @default("rey7214935@gmail.com")
  bankAccount    String   @default("LAFISE")
  status         String   @default("PENDING") // PENDING, PAID, FAILED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── Loyalty Points System ──────────────────────────────────────────────────

model LoyaltyPoint {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0) // Current points balance
  totalEarned Int    @default(0) // Total lifetime points earned
  totalRedeemed Int  @default(0) // Total lifetime points redeemed
  expiresAt DateTime? // When all points expire (12 months of inactivity)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PointHistory {
  id        String   @id @default(cuid())
  userId    String
  type      String   // EARN, REDEEM, EXPIRE, BONUS
  amount    Int      // Positive for earn/bonus, negative for redeem/expire
  reason    String   @default("") // Description
  transactionId String? // Related transaction ID (for earn)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Star Rating & Trust System ─────────────────────────────────────────────

model Review {
  id          String   @id @default(cuid())
  reviewerId  String   // Who is writing the review
  targetId    String   // Who is being reviewed (seller or buyer)
  transactionId String // Must be a verified completed transaction
  rating      Int      // 1 to 5 stars
  comment     String   @default("")
  reviewType  String   // SELLER_REVIEW, BUYER_REVIEW
  response    String   @default("") // Seller/buyer can respond once
  helpfulYes  Int      @default(0) // "Helpful" votes
  helpfulNo   Int      @default(0) // "Not helpful" votes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviewer    User @relation("GivenRatings", fields: [reviewerId], references: [id], onDelete: Cascade)
  target      User @relation("ReceivedRatings", fields: [targetId], references: [id], onDelete: Cascade)
  votes       ReviewVote[]

  @@unique([reviewerId, transactionId, reviewType]) // One review per transaction per type
}

model ReviewVote {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  isHelpful Boolean  // true = helpful, false = not helpful
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
}

// ─── Calendar & Agenda System ───────────────────────────────────────────────

model CalendarEvent {
  id          String   @id @default(cuid())
  userId      String   // Owner of the event
  title       String
  description String   @default("")
  eventType   String   @default("other") // meeting, delivery, restock, other
  eventDate   DateTime
  duration    Int      @default(60) // Duration in minutes
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Appointment {
  id          String   @id @default(cuid())
  buyerId     String
  sellerId    String
  title       String
  description String   @default("")
  eventDate   DateTime
  duration    Int      @default(30) // Duration in minutes
  status      String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  buyer  User @relation("BuyerAppointments", fields: [buyerId], references: [id], onDelete: Cascade)
  seller User @relation("SellerAppointments", fields: [sellerId], references: [id], onDelete: Cascade)
}
