{
    "name": "proveedorconecta/email-service",
    "description": "ProveedorConecta Nicaragua - Email Service for verification and password reset emails",
    "type": "project",
    "require": {
        "php": "^8.2",
        "slim/slim": "^4.13",
        "slim/psr7": "^1.7",
        "phpmailer/phpmailer": "^6.9"
    },
    "autoload": {
        "psr-4": {
            "ProveedorConecta\\EmailService\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "start": "php -S 0.0.0.0:8083 -t ."
    }
}
