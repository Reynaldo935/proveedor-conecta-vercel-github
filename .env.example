# ─── Database ───────────────────────────────────────────────────────────────
# Local development (SQLite file)
DATABASE_URL=file:./db/custom.db

# Turso Cloud (production on Vercel)
TURSO_DATABASE_URL=libsql://proveedor-conecta-reynaldo935.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ─── Vercel Blob (file uploads) ────────────────────────────────────────────
# Automatically set when you enable Vercel Blob store in your project dashboard
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ─── Google OAuth 2.0 ─────────────────────────────────────────────────────
# https://console.cloud.google.com/
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Google Maps JavaScript API ────────────────────────────────────────────
# https://console.cloud.google.com/
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-map-id

# ─── Payment Gateways ──────────────────────────────────────────────────────
# PixelPay (Nicaragua payment gateway)
# PIXELPAY_API_KEY=your-pixelpay-api-key
# PIXELPAY_SECRET=your-pixelpay-secret
# PIXELPAY_WEBHOOK_SECRET=your-pixelpay-webhook-secret

# PayPal
# PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Stripe (ad subscriptions)
# STRIPE_SECRET_KEY=your-stripe-secret-key
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# ─── Real-time Chat ────────────────────────────────────────────────────────
# Pusher (alternative to Socket.IO on Vercel)
# PUSHER_APP_ID=your-pusher-app-id
# PUSHER_KEY=your-pusher-key
# PUSHER_SECRET=your-pusher-secret
# PUSHER_CLUSTER=us2

# ─── File Storage ──────────────────────────────────────────────────────────
# Uploadthing
# UPLOADTHING_SECRET=your-uploadthing-secret

# Cloudinary (alternative)
# CLOUDINARY_URL=cloudinary://xxx:xxx@xxx

# ─── Caching & Rate Limiting ──────────────────────────────────────────────
# Upstash Redis
# UPSTASH_REDIS_URL=https://xxx.upstash.io
# UPSTASH_REDIS_TOKEN=your-upstash-token

# ─── AI Chatbot Providers ─────────────────────────────────────────────────
# Z.ai (built-in with z-ai-web-dev-sdk, no key needed in this environment)
# ZAI_API_KEY=your-zai-api-key

# OpenAI
# OPENAI_API_KEY=your-openai-api-key

# Google Gemini
# GEMINI_API_KEY=your-gemini-api-key

# DeepSeek
# DEEPSEEK_API_KEY=your-deepseek-api-key

# Grok (xAI)
# GROK_API_KEY=your-grok-api-key

# ─── Email Service ─────────────────────────────────────────────────────────
# SMTP (for verification emails, password reset)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ─── Commission Webhook ────────────────────────────────────────────────────
# COMMISSION_WEBHOOK_SECRET=your-secret-here

# ─── Polyglot Microservice URLs (when deployed) ───────────────────────────
# CHATBOT_SERVICE_URL=http://localhost:8001
# VALIDATION_SERVICE_URL=http://localhost:8080
# PAYMENT_SERVICE_URL=http://localhost:8081
# ADMIN_SERVICE_URL=http://localhost:8082
# EMAIL_SERVICE_URL=http://localhost:8083
