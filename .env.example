# ============================================================================
# ProveedorConecta Nicaragua - Environment Variables (19 External APIs)
# ============================================================================
# Copy this file to .env and fill in your values.
# For Vercel: Add these in Project Settings > Environment Variables.
# ============================================================================

# --- 1. Database: Turso Cloud (REQUIRED for production) ----------------------
# Local development: SQLite file path
DATABASE_URL=file:./db/custom.db

# Turso Cloud (production on Vercel) - https://turso.tech/app
TURSO_DATABASE_URL=libsql://your-db-name-your-org.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# --- 2. App URL (REQUIRED for production) ------------------------------------
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- 3. Google OAuth 2.0 -----------------------------------------------------
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- 4. Google Maps JavaScript API -------------------------------------------
# https://console.cloud.google.com/apis/library/maps-javascript-api
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-map-id

# --- 5. Open-Meteo Weather API (FREE, no key needed) -------------------------
# No configuration required - used directly in /api/weather route
# https://open-meteo.com/

# --- 6. PixelPay (Nicaragua Payment Gateway) ---------------------------------
# https://pixelpay.co
PIXELPAY_API_KEY=your-pixelpay-api-key
PIXELPAY_SECRET=your-pixelpay-secret-key
PIXELPAY_WEBHOOK_SECRET=your-pixelpay-webhook-secret
PIXELPAY_SANDBOX=true

# --- 7. Pagadito (Central America Payment Gateway) ---------------------------
# https://comercios.pagadito.com
PAGADITO_UID=your-pagadito-uid
PAGADITO_WSK=your-pagadito-wsk
PAGADITO_SANDBOX=true

# --- 8. PayPal ----------------------------------------------------------------
# https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_SANDBOX=true

# --- 9. Stripe (Ad Subscriptions) ---------------------------------------------
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# --- 10. Pusher (Real-time Chat) ----------------------------------------------
# https://dashboard.pusher.com/ - Vercel compatible (not Socket.IO)
PUSHER_APP_ID=your-pusher-app-id
PUSHER_KEY=your-pusher-key
PUSHER_SECRET=your-pusher-secret
PUSHER_CLUSTER=us2
NEXT_PUBLIC_PUSHER_KEY=your-pusher-key
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# --- 11. Vercel Blob (File Storage - Primary) ---------------------------------
# Auto-configured when enabling Blob store in Vercel dashboard
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# --- 12. Cloudinary (File Storage - Alternative) ------------------------------
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# --- 13. Upstash Redis (Caching & Rate Limiting) -----------------------------
# https://upstash.com/dashboard
UPSTASH_REDIS_URL=https://your-redis.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-token

# --- 14. Z.ai AI Provider (Built-in, z-ai-web-dev-sdk) ----------------------
# Works out of the box, optional API key
ZAI_API_KEY=your-zai-api-key

# --- 15. OpenAI ---------------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# --- 16. Google Gemini --------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# --- 17. DeepSeek -------------------------------------------------------------
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key

# --- 18. Grok (xAI) ----------------------------------------------------------
# https://console.x.ai/
GROK_API_KEY=your-grok-api-key

# --- 19a. Blackbox AI ---------------------------------------------------------
# https://www.blackbox.ai/
BLACKBOX_API_KEY=your-blackbox-api-key

# --- 19b. NotebookLM (Google) ------------------------------------------------
# Can use same key as Gemini or separate key
NOTEBOOKLM_API_KEY=your-notebooklm-api-key

# --- Email Service (SMTP) ----------------------------------------------------
# Gmail: Use App Password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@proveedorconecta.com

# --- Security -----------------------------------------------------------------
# JWT secret for session tokens (generate a random 32+ char string)
JWT_SECRET=your-super-secret-jwt-key-change-this
COMMISSION_WEBHOOK_SECRET=your-commission-webhook-secret

# --- Commission Configuration -------------------------------------------------
# 3% commission on all transactions
COMMISSION_RATE=0.03
COMMISSION_DESTINATION_EMAIL=rey7214935@gmail.com
COMMISSION_DESTINATION_BANK=LAFISE

# --- Admin Account ------------------------------------------------------------
ADMIN_EMAIL=rey7214935@gmail.com
ADMIN_DEFAULT_PASSWORD=admin123
# All user accounts (admin, sellers, buyers) use password: admin123
