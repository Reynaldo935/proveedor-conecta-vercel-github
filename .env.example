# ─── Database ───────────────────────────────────────────────────────────────
# Local development (SQLite file)
DATABASE_URL=file:./db/custom.db

# Turso Cloud (production on Vercel)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ─── App ────────────────────────────────────────────────────────────────────
# Public URL of the deployed app (used for email verification links)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ─── Vercel Blob (file uploads) ────────────────────────────────────────────
# Automatically set when you enable Vercel Blob store in your project dashboard
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ─── Commission Webhook ────────────────────────────────────────────────────
# Optional: secret for commission webhook verification
# COMMISSION_WEBHOOK_SECRET=your-secret-here

# ─── Google Maps (optional) ────────────────────────────────────────────────
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-map-id

# ─── Creators Endpoint (optional) ─────────────────────────────────────────
# NEXT_PUBLIC_CREATORS_ENDPOINT=https://your-api-endpoint/creators
