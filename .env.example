# ============================================================================
# ProveedorConecta Nicaragua - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# For Vercel: Add these in Project Settings > Environment Variables.
# Variables marked NEXT_PUBLIC_ are exposed to the browser.
# ============================================================================

# ─── Database (Turso Cloud) ──────────────────────────────────────────────────
# Production: Turso Cloud SQLite - https://turso.tech/app
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Local SQLite fallback (development only)
DATABASE_URL=file:./db/custom.db

# ─── n8n Automation Webhook ──────────────────────────────────────────────────
# n8n workflow automation for commission processing and notifications
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-webhook-id

# ─── AI Provider (optional - chatbot works without it) ───────────────────────
# Z.ai built-in AI provider (z-ai-web-dev-sdk) - works out of the box
ZAI_API_KEY=your-zai-api-key

# ─── Weather API (optional - uses Open-Meteo free API by default) ────────────
# OpenWeatherMap API key - https://openweathermap.org/api
# Not required: the app uses the free Open-Meteo API by default
OPENWEATHER_API_KEY=your-openweather-api-key

# ─── Pusher (Real-time Chat) ────────────────────────────────────────────────
# Pusher Channels for real-time messaging - https://dashboard.pusher.com/
# Vercel-compatible (not Socket.IO which requires persistent connections)
PUSHER_APP_ID=your-pusher-app-id
PUSHER_KEY=your-pusher-key
PUSHER_SECRET=your-pusher-secret
PUSHER_CLUSTER=us2
NEXT_PUBLIC_PUSHER_KEY=your-pusher-key
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Resend email delivery API - https://resend.com/
RESEND_API_KEY=your-resend-api-key

# ─── Cloudinary (Image Upload) ──────────────────────────────────────────────
# Cloudinary media management - https://cloudinary.com/console
# Alternative to Vercel Blob for image storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ─── App URL ─────────────────────────────────────────────────────────────────
# Public URL of your deployed application
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# NextAuth.js configuration
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-min-32-chars
NEXTAUTH_URL=https://your-app.vercel.app

# ─── Admin Email ─────────────────────────────────────────────────────────────
# Primary admin account email
ADMIN_EMAIL=rey7214935@gmail.com

# ============================================================================
# OPTIONAL SERVICES (below this line are optional integrations)
# ============================================================================

# ─── Google OAuth 2.0 (optional) ────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Google Maps JavaScript API (optional) ──────────────────────────────────
# https://console.cloud.google.com/apis/library/maps-javascript-api
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-map-id

# ─── PixelPay - Nicaragua Payment Gateway (optional) ────────────────────────
# https://pixelpay.co
PIXELPAY_API_KEY=your-pixelpay-api-key
PIXELPAY_SECRET=your-pixelpay-secret-key
PIXELPAY_WEBHOOK_SECRET=your-pixelpay-webhook-secret
PIXELPAY_SANDBOX=true

# ─── Pagadito - Central America Payment Gateway (optional) ──────────────────
# https://comercios.pagadito.com
PAGADITO_UID=your-pagadito-uid
PAGADITO_WSK=your-pagadito-wsk
PAGADITO_SANDBOX=true

# ─── PayPal (optional) ──────────────────────────────────────────────────────
# https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_SANDBOX=true

# ─── Stripe - Ad Subscriptions (optional) ───────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# ─── Vercel Blob - File Storage (optional) ──────────────────────────────────
# Auto-configured when enabling Blob store in Vercel dashboard
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ─── Upstash Redis - Caching & Rate Limiting (optional) ─────────────────────
# https://upstash.com/dashboard
UPSTASH_REDIS_URL=https://your-redis.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-token

# ─── OpenAI (optional) ──────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# ─── Google Gemini (optional) ───────────────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ─── DeepSeek (optional) ────────────────────────────────────────────────────
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── Grok / xAI (optional) ─────────────────────────────────────────────────
# https://console.x.ai/
GROK_API_KEY=your-grok-api-key

# ─── Blackbox AI (optional) ─────────────────────────────────────────────────
# https://www.blackbox.ai/
BLACKBOX_API_KEY=your-blackbox-api-key

# ─── NotebookLM (optional) ──────────────────────────────────────────────────
# Can use same key as Gemini or separate key
NOTEBOOKLM_API_KEY=your-notebooklm-api-key

# ─── Email Service - SMTP fallback (optional) ───────────────────────────────
# Gmail: Use App Password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@proveedorconecta.com

# ─── Security (optional) ────────────────────────────────────────────────────
# JWT secret for session tokens (generate a random 32+ char string)
JWT_SECRET=your-super-secret-jwt-key-change-this
COMMISSION_WEBHOOK_SECRET=your-commission-webhook-secret

# ─── Commission Configuration ────────────────────────────────────────────────
# 3% commission on all transactions
COMMISSION_RATE=0.03
COMMISSION_DESTINATION_EMAIL=rey7214935@gmail.com
COMMISSION_DESTINATION_BANK=LAFISE

# ─── Admin Account ───────────────────────────────────────────────────────────
ADMIN_DEFAULT_PASSWORD=admin123
# All user accounts (admin, sellers, buyers) use password: admin123
